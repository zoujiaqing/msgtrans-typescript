{
  "name": "@msgtrans/client",
  "version": "0.3.0-beta.0",
  "description": "TypeScript client runtime for the msgtrans wire protocol \u2014 language mapping of the Rust crate, browser-first, WebSocket transport.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts tests/e2e/echo-server.test.ts",
    "test:e2e:official": "vitest run --config vitest.e2e.config.ts tests/e2e/official-echo-server.test.ts",
    "test:e2e:all": "vitest run --config vitest.e2e.config.ts",
    "sync-fixtures": "node scripts/sync-fixtures.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "api-report": "node scripts/gen-api-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "author": "Jiaqing Zou <zoujiaqing@gmail.com>",
  "homepage": "https://github.com/zoujiaqing/msgtrans-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoujiaqing/msgtrans-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/zoujiaqing/msgtrans-typescript/issues"
  },
  "keywords": [
    "msgtrans",
    "websocket",
    "binary-protocol",
    "wire-format",
    "rpc",
    "transport"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false
}
